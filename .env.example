# ContratBox — Variables d'environnement
# Copier vers .env et remplir les valeurs

# Database (PostgreSQL — Railway, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/contratbox?sslmode=require"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Prefer AUTH_URL on Auth.js v5 (NEXTAUTH_URL also supported)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# URL publique de l’app (redirections Stripe Checkout / portail client)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (emails transactionnels + magic link)
AUTH_RESEND_KEY="re_xxx"
RESEND_API_KEY="re_xxx"
EMAIL_FROM="ContratBox <onboarding@resend.dev>"

# OpenRouter (LLM — extraction + assistant)
OPENROUTER_API_KEY="sk-or-xxx"
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# OCR documents (Tesseract 5 via tesseract.js + rendu PDF pdf-to-png-converter ; Node 20+)
# Les moteurs OSS les plus performants en doc (PaddleOCR, Surya) sont surtout Python — branchables plus tard via un microservice (OCR_REMOTE_URL).
OCR_ENABLED="true"
# auto = OCR si peu de texte PDF natif ; always = toujours rasteriser (meilleur sur PDF « sales ») ; never = pdf-parse seul
OCR_MODE="auto"
OCR_MIN_NATIVE_CHARS="180"
OCR_MAX_PDF_PAGES="12"
OCR_VIEWPORT_SCALE="1.75"
# Langues Tesseract (codes +) : https://github.com/naptha/tesseract.js/blob/master/docs/tesseract_lang_list.md
OCR_TESSERACT_LANGS="fra+deu+ita+eng"

# Cloudflare R2 (stockage documents)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="contratbox-documents"
# API endpoint S3 R2 (ex: https://<accountid>.r2.cloudflarestorage.com)
R2_ENDPOINT=""
R2_PUBLIC_URL="https://xxx.r2.cloudflarestorage.com"
R2_UPLOAD_TIMEOUT_MS="45000"

# Stripe (facturation)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# Webhook (App Router) : POST https://<domaine>/api/stripe/webhook
# Checkout / abonnement : renseigner metadata.userId = id utilisateur ContratBox pour lier la synchro.

# Price IDs → plan (voir lib/config/plans.ts — resolvePlanSlugFromStripePriceId)
# Priorité solo : STRIPE_PRICE_ID_SOLO, sinon alias legacy STRIPE_PRICE_ID_MONTHLY
STRIPE_PRICE_ID_SOLO=""
STRIPE_PRICE_ID_MONTHLY="price_xxx"
STRIPE_PRICE_ID_FAMILY=""
# Care / Pro : STRIPE_PRICE_ID_CARE, sinon alias legacy STRIPE_PRO_PRICE_ID
STRIPE_PRICE_ID_CARE=""
STRIPE_PRO_PRICE_ID=""

# NextLetter (CTA résiliation — optionnel)
NEXTLETTER_BASE_URL="https://nextletter.ch"
