// ContratBox — Schéma Prisma
// PostgreSQL — ménages, contrats, extraction IA, abonnements

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ——— Auth (NextAuth) ———
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user") // user | admin
  isOwner       Boolean   @default(false)
  isTenant      Boolean   @default(true)
  onboardingCompletedAt DateTime?
  /** Token unique pour la réception de factures par email (factures+<token>@…). */
  inboundEmailToken String?  @unique
  /** Surcharge admin du quota IA mensuel (null = utiliser le plan). */
  aiQuotaOverride   Int?
  /** Modules supplémentaires accordés manuellement par un admin. */
  extraModules      String[] @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  households       Household[]       @relation("HouseholdOwner")
  householdMembers HouseholdMember[]
  contracts        Contract[]
  bills            Bill[]
  aiChatThreads    AIChatThread[]
  aiAssistantAttachments AiAssistantAttachment[]
  aiUsageMonths    AiUsageMonth[]
  subscription     Subscription?
  auditLogs        AuditLog[]
  householdTasksCreated HouseholdTask[] @relation("HouseholdTaskCreator")
  administrativeItemsCreated AdministrativeItem[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// ——— Ménage & membres ———
model Household {
  id        String   @id @default(cuid())
  name      String   // ex: Famille Petronio
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User              @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members HouseholdMember[]
  contracts Contract[]
  bills    Bill[]
  realEstateProperties RealEstateProperty[]
  tasks HouseholdTask[]
  administrativeItems AdministrativeItem[]
  aiAssistantAttachments AiAssistantAttachment[]
  reminders Reminder[]
}

model HouseholdMember {
  id           String    @id @default(cuid())
  householdId  String
  userId       String?   // null = membre invité (pas encore utilisateur)
  firstName    String
  lastName     String?
  role         String    // adult | child | other
  dateOfBirth  DateTime? @db.Date
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  contracts  Contract[]
  bills      Bill[]
  assignedTasks HouseholdTask[] @relation("HouseholdTaskAssignee")
}

// ——— Contrats & documents ———
model Contract {
  id              String    @id @default(cuid())
  householdId     String
  createdById     String

  // Métadonnées de base
  title           String?
  provider        String?
  contractType    String?
  category        String?   // slug: household_insurance, health_basic, etc.
  policyNumber    String?
  memberId        String?   // null = ménage entier
  isHouseholdWide Boolean   @default(false)

  // Finances
  premiumAmount   Decimal?  @db.Decimal(12, 2)
  premiumFrequency String?  // monthly | annual
  currency       String    @default("CHF")

  // Dates
  startDate      DateTime? @db.Date
  renewalDate    DateTime? @db.Date
  endDate        DateTime? @db.Date
  maturityDate   DateTime? @db.Date // hypothèque
  cancellationNoticeDays Int?
  autoRenewal    Boolean?
  cancellationDeadline   DateTime? @db.Date // calculé

  // Hypothèque
  mortgageRate   Decimal?  @db.Decimal(6, 4)
  interestAmountPaid    Decimal?  @db.Decimal(12, 2)

  // Contenu IA
  extractedText  String?   @db.Text
  extractionConfidence  Decimal?  @db.Decimal(5, 2)
  coverageSummary String?  @db.Text
  exclusions     String?  @db.Text
  importantClauses String? @db.Text
  rawExtraction  Json?    // structure libre pour confiance par champ
  extractedAt    DateTime?

  status         String    @default("active") // active | cancelled | expired
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  member     HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  documents  Document[]
  reminders  Reminder[]
  tasks      HouseholdTask[]
  bills      Bill[]
  convertedFromInboxItems AdministrativeItem[] @relation("AdministrativeItemConvertedContract")
  decisionInsight ContractDecisionInsight?
}

/// Snapshot décisionnel / économies — alimenté par règles + IA (optionnel)
model ContractDecisionInsight {
  id                      String   @id @default(cuid())
  contractId              String   @unique
  estimatedImpactChfYear Decimal  @default(0) @db.Decimal(12, 2)
  riskLevel               String   @default("low") // low | medium | high
  nextAction              String   @default("") @db.Text
  canCancelNow            Boolean  @default(false)
  priorityScore           Int      @default(0) // 0–100
  urgencyLevel            String   @default("low") // low | medium | high
  recommendationKind     String?  // renegotiate | cancel | switch_provider | keep | none
  signals                 Json?
  computedAt              DateTime @default(now())
  updatedAt               DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model Document {
  id         String   @id @default(cuid())
  contractId String
  name       String
  mimeType   String
  sizeBytes  Int
  r2Key      String   // clé dans R2
  r2Bucket   String?
  extractedText String? @db.Text
  /// Provenance OCR / PDF natif, stats par page — pour RAG & agent futur
  textExtractionMeta Json?
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tasks    HouseholdTask[]
}

// ——— Inbox administrative (hors Document/contrat) ———
model AdministrativeItem {
  id           String @id @default(cuid())
  householdId  String
  createdById  String

  originalFilename String
  mimeType         String
  sizeBytes        Int
  r2Key            String
  r2Bucket         String?

  status String @default("active") // active | archived

  classification String? // invoice | reminder | letter | lease | insurance | tax | bank | health | subscription | other
  urgency        String? // low | medium | high | critical
  summary             String?  @db.Text
  recommendedAction   String?  @db.Text
  dueDate             DateTime? @db.Date
  extractedText       String?  @db.Text
  extractionConfidence Decimal? @db.Decimal(5, 2)
  rawExtraction Json?
  textExtractionMeta Json?
  convertedToContractId String?
  convertedToBillId    String?
  convertedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  convertedToContract Contract? @relation("AdministrativeItemConvertedContract", fields: [convertedToContractId], references: [id], onDelete: SetNull)
  convertedToBill     Bill?     @relation("AdministrativeItemConvertedBill", fields: [convertedToBillId], references: [id], onDelete: SetNull)
  /** Tâches dérivées (la logique métier limite à 1 via service). */
  derivedTasks HouseholdTask[]

  @@index([householdId, status])
  @@index([convertedToContractId])
  @@index([convertedToBillId])
}

// ——— Factures mensuelles ———
model Bill {
  id              String   @id @default(cuid())
  householdId     String
  createdById     String

  /** Lien optionnel vers le contrat parent (ex : facture mensuelle Swisscom liée au contrat Swisscom). */
  contractId      String?
  /** Lien optionnel vers un membre du ménage. */
  memberId        String?
  isHouseholdWide Boolean  @default(false)

  /** Titre court (ex: « Facture Swisscom mars 2026 »). */
  title           String
  /** Émetteur (Swisscom, Romande Énergie, CSS…). */
  provider        String?
  /** Slug de catégorie (electricity, telecom, insurance_premium, rent, taxes, healthcare, other). */
  category        String?

  invoiceNumber   String?
  /** Référence (BVR / QR-bill / IBAN). */
  reference       String?

  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("CHF")

  /** Date d'émission de la facture. */
  issueDate       DateTime? @db.Date
  /** Date d'échéance. */
  dueDate         DateTime? @db.Date
  /** Date de paiement effective. */
  paidAt          DateTime?
  status          String   @default("pending") // pending | paid | overdue | disputed | cancelled

  /** Facture récurrente : monthly | quarterly | annual | one_off. */
  recurrence      String   @default("one_off")

  /** Origine de la saisie. */
  source          String   @default("manual") // manual | ocr | email | inbox_conversion

  notes           String?  @db.Text

  // Extraction IA / OCR
  extractedText        String? @db.Text
  extractionConfidence Decimal? @db.Decimal(5, 2)
  rawExtraction        Json?
  textExtractionMeta   Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  contract  Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  member    HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  documents BillDocument[]
  reminders Reminder[]
  /** Items inbox convertis en cette facture (traçabilité). */
  convertedFromInboxItems AdministrativeItem[] @relation("AdministrativeItemConvertedBill")

  @@index([householdId, status])
  @@index([householdId, dueDate])
  @@index([contractId])
  @@index([memberId])
}

model BillDocument {
  id            String   @id @default(cuid())
  billId        String
  name          String
  mimeType      String
  sizeBytes     Int
  r2Key         String
  r2Bucket      String?
  extractedText String?  @db.Text
  textExtractionMeta Json?
  createdAt     DateTime @default(now())

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

// ——— Suivi usage assistant IA (quota mensuel) ———
model AiUsageMonth {
  id        String   @id @default(cuid())
  userId    String
  /** Premier jour du mois UTC (clé d'agrégation). */
  monthStart DateTime @db.Date
  /** Nombre de questions consommées sur le mois. */
  questionsCount Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthStart])
  @@index([userId])
}

// ——— Tâches foyer (workflow admin) ———
model HouseholdTask {
  id          String   @id @default(cuid())
  householdId String
  createdById String

  title       String
  description String?  @db.Text

  status   String @default("todo") // todo | in_progress | waiting | done | archived
  priority String @default("medium") // low | medium | high | urgent

  dueDate DateTime? @db.Date

  contractId         String?
  realEstatePropertyId String?
  documentId         String?
  assignedToMemberId String?

  /** Tâche issue d’un document inbox (traçabilité) */
  sourceAdministrativeItemId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household  Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy  User             @relation("HouseholdTaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  contract   Contract?        @relation(fields: [contractId], references: [id], onDelete: SetNull)
  realEstateProperty RealEstateProperty? @relation(fields: [realEstatePropertyId], references: [id], onDelete: SetNull)
  document   Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  assignedTo HouseholdMember? @relation("HouseholdTaskAssignee", fields: [assignedToMemberId], references: [id], onDelete: SetNull)
  sourceAdministrativeItem AdministrativeItem? @relation(fields: [sourceAdministrativeItemId], references: [id], onDelete: SetNull)

  @@index([householdId, status])
  @@index([createdById])
  @@index([realEstatePropertyId])
  @@index([sourceAdministrativeItemId])
}

// ——— Patrimoine immobilier ———
model RealEstateProperty {
  id          String   @id @default(cuid())
  householdId String
  name        String
  address     String?
  propertyType String  @default("apartment") // apartment | house | mixed | commercial | other
  /** rental = locatif / rendement ; primary_residence = habitation propre (pas de rendement locatif par défaut) */
  investmentKind String @default("rental") // rental | primary_residence
  /** Prix d’achat (CHF) — input formulaire « valeur d’achat ». */
  purchaseValueChf Decimal? @db.Decimal(14, 2)
  /** Date d’achat (optionnelle). */
  purchaseDate     DateTime? @db.Date
  /** Valeur actuelle / estimée (CHF) — base pour le rendement brut / net. */
  valuationChf Decimal? @db.Decimal(14, 2)
  /** Taux d’amortissement annuel par défaut du bien (%). 1.25 % = standard suisse 2e rang. */
  amortizationRatePct Decimal @default(1.25) @db.Decimal(6, 4)
  /** Mode d’amortissement par défaut : direct (rembourse la dette) ou indirect (3e pilier). */
  amortizationMode String @default("direct") // direct | indirect
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  mortgageLoans MortgageLoan[]
  leases LeaseUnit[]
  charges PropertyCharge[]
  chargeStatements ChargeStatement[]
  tasks HouseholdTask[]
  reminders Reminder[]

  @@index([householdId, isActive])
}

model MortgageLoan {
  id                  String   @id @default(cuid())
  realEstatePropertyId String
  label               String   @default("Dette hypothécaire")
  loanKind            String   @default("mortgage") // mortgage | amortization
  amortizationMode    String   @default("direct") // direct | indirect (utile si loanKind=amortization)
  principalTotal      Decimal  @db.Decimal(14, 2)
  amortizationRatePct Decimal  @default(1.25) @db.Decimal(6, 4)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  realEstateProperty RealEstateProperty @relation(fields: [realEstatePropertyId], references: [id], onDelete: Cascade)
  tranches MortgageTranche[]

  @@index([realEstatePropertyId])
}

model MortgageTranche {
  id             String   @id @default(cuid())
  mortgageLoanId String
  name           String?
  principal      Decimal  @db.Decimal(14, 2)
  rateType       String   @default("fixed") // fixed | saron
  ratePct        Decimal  @db.Decimal(6, 4)
  startDate      DateTime? @db.Date
  endDate        DateTime? @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  mortgageLoan MortgageLoan @relation(fields: [mortgageLoanId], references: [id], onDelete: Cascade)

  @@index([mortgageLoanId])
  @@index([endDate])
}

model PropertyCharge {
  id                  String   @id @default(cuid())
  realEstatePropertyId String
  label               String
  chargeType          String   @default("other") // ppe | maintenance | insurance | utilities | tax | other
  amount              Decimal  @db.Decimal(12, 2)
  frequency           String   @default("monthly") // monthly | quarterly | annual
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  realEstateProperty RealEstateProperty @relation(fields: [realEstatePropertyId], references: [id], onDelete: Cascade)

  @@index([realEstatePropertyId])
}

model LeaseUnit {
  id                  String   @id @default(cuid())
  realEstatePropertyId String
  label               String   @default("Lot principal")
  tenantName          String?
  /** Date d’entrée du locataire (début du bail). */
  startDate           DateTime? @db.Date
  /** Date de fin du bail (optionnelle). */
  endDate             DateTime? @db.Date
  isRented            Boolean  @default(false)
  rentMonthly         Decimal  @default(0) @db.Decimal(12, 2)
  chargesMonthly      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  realEstateProperty RealEstateProperty @relation(fields: [realEstatePropertyId], references: [id], onDelete: Cascade)
  rentPayments RentPayment[]

  @@index([realEstatePropertyId, isRented])
}

model RentPayment {
  id         String   @id @default(cuid())
  leaseUnitId String
  month      DateTime @db.Date // utiliser le 1er du mois
  expectedAmount Decimal @db.Decimal(12, 2)
  receivedAmount Decimal @default(0) @db.Decimal(12, 2)
  status     String   @default("pending") // pending | paid | partial | late
  receivedAt DateTime? @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leaseUnit LeaseUnit @relation(fields: [leaseUnitId], references: [id], onDelete: Cascade)

  @@unique([leaseUnitId, month])
  @@index([month, status])
}

model ChargeStatement {
  id                  String   @id @default(cuid())
  realEstatePropertyId String
  periodStart         DateTime @db.Date
  periodEnd           DateTime @db.Date
  tenantAllocationPct Decimal  @default(100) @db.Decimal(5, 2)
  totalChargesAmount  Decimal  @db.Decimal(12, 2)
  totalProvisionsAmount Decimal @default(0) @db.Decimal(12, 2)
  balanceAmount       Decimal  @db.Decimal(12, 2)
  payload             Json
  nextLetterIntentAt  DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  realEstateProperty RealEstateProperty @relation(fields: [realEstatePropertyId], references: [id], onDelete: Cascade)

  @@index([realEstatePropertyId, periodStart, periodEnd])
}

// ——— IA ———
/** PDF/images importés depuis l’assistant (contrats hors base ou offres assureurs) — texte extrait pour contexte chat */
model AiAssistantAttachment {
  id               String   @id @default(cuid())
  householdId      String
  createdById      String
  label            String
  mimeType         String
  /** proposal | policy | other */
  kind             String   @default("proposal")
  extractedText    String   @db.Text
  textExtractionMeta Json?
  createdAt        DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
}

model AIChatThread {
  id          String   @id @default(cuid())
  userId      String
  householdId String?
  title       String?  @default("Nouvelle conversation")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIChatMessage[]
}

model AIChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      String   // user | assistant | system
  content   String   @db.Text
  sources   String[] // IDs contrats ou extraits cités
  createdAt DateTime @default(now())

  thread AIChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

// ——— Prompts admin ———
model PromptTemplate {
  id          String   @id @default(cuid())
  key         String   @unique // assistant_system | extraction_main | category_rules
  name        String
  content     String   @db.Text
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ——— Abonnement Stripe ———
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  status               String    // active | cancelled | past_due | trialing | free
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ——— Rappels (alertes actionnables, sync trigger_engine + autres sources) ———
model Reminder {
  id                     String    @id @default(cuid())
  householdId            String
  contractId             String?
  propertyId             String?
  billId                 String?

  type                   String // contract_renewal | cancellation_deadline | mortgage_expiry | savings_opportunity | bill_due
  title                  String
  description            String    @db.Text
  dueDate                DateTime  @db.Date
  urgencyLevel           String    @default("medium") // low | medium | high
  estimatedImpactChfYear Decimal?  @db.Decimal(12, 2)
  status                 String    @default("pending") // pending | sent | dismissed | completed
  source                 String    @default("trigger_engine")
  /** Idempotence sync (ex. trigger_engine:mortgage_expiry:contractId:2026-01-01:Tranche1) */
  dedupeKey              String?

  sentAt                 DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  contract  Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  property  RealEstateProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  bill      Bill? @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([householdId, status, dueDate])
  @@index([contractId, status])
  @@index([billId, status])
  @@index([dedupeKey])
}

// ——— Audit / admin ———
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String?  // contract | user | household
  resourceId String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
